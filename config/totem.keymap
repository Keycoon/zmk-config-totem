//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt { tapping-term-ms = <140>; };

&mt {
    tapping-term-ms = <280>;
    flavor = "balanced";
    require-prior-idle-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        dobleCtrl {
            bindings = <&kp F13>;
            key-positions = <15 14>;
            layers = <0 1>;
        };

        ctrlAlt {
            bindings = <&kp LC(A)>;
            key-positions = <10 34>;
            layers = <0 1>;
        };

        controlX {
            bindings = <&kp LC(X)>;
            key-positions = <13 12 11>;
        };

        ctrlV {
            bindings = <&kp LC(V)>;
            key-positions = <23 24>;
        };

        ctrlC {
            bindings = <&kp LC(C)>;
            key-positions = <12 13>;
        };

        f6 {
            bindings = <&kp F6>;
            key-positions = <35 15>;
        };

        ctrlZ {
            bindings = <&kp LC(Z)>;
            key-positions = <21 22>;
        };

        ctrlShiftZ {
            bindings = <&kp LC(RS(Z))>;
            key-positions = <21 22 23>;
        };

        f5 {
            bindings = <&kp F5>;
            key-positions = <4 34>;
            layers = <0 1>;
        };

        dvorak {
            bindings = <&to 0>;
            key-positions = <4 20>;
            layers = <1 2>;
        };

        qwerty {
            bindings = <&to 1>;
            key-positions = <4 20>;
            layers = <0 2>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <34 35>;
            layers = <0 1>;
        };

        japonesOcr {
            bindings = <&kp RA(F7)>;
            key-positions = <34 32>;
            layers = <0 1>;
        };

        blutoohClear {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <9 0>;
        };

        spaceDos {
            bindings = <&kp SPACE>;
            key-positions = <11 13>;
            layers = <0 1 2>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 34>;
        };

        save {
            bindings = <&kp LC(S)>;
            key-positions = <12 20>;
        };

        altF4 {
            bindings = <&kp LA(F4)>;
            key-positions = <6 8>;
        };

        menu_win {
            bindings = <&kp LG(E)>;
            key-positions = <1 2>;
            layers = <0 1>;
        };

        shiftEnter {
            bindings = <&kp LS(ENTER)>;
            key-positions = <33 36>;
            layers = <1 4>;
        };

        blender {
            bindings = <&to 2>;
            key-positions = <20 14>;
            layers = <0 1>;
        };

        f11 {
            bindings = <&kp F11>;
            key-positions = <26 35>;
        };

        anki {
            bindings = <&to 0>;
            key-positions = <20 0>;
        };
    };

    macros {
        pregunta: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_0>,
                <&macro_tap>,
                <&kp KP_N1>,
                <&macro_tap>,
                <&kp KP_NUMBER_9>,
                <&macro_tap>,
                <&kp KP_N1>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "NEW_MACRO";
        };

        exclamacion: exclamacion {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N1>,
                <&macro_tap>,
                <&kp KP_N7>,
                <&macro_tap>,
                <&kp KP_N3>,
                <&macro_release>,
                <&kp LEFT_ALT>;
        };

        em_dash: em_dash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0>,
                <&macro_tap>,
                <&kp KP_N1>,
                <&macro_tap>,
                <&kp KP_N5>,
                <&macro_tap>,
                <&kp KP_N1>,
                <&macro_release>,
                <&kp LEFT_ALT>;
        };

        guillemet_left: guillemet_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0>,
                <&macro_tap>,
                <&kp KP_N1>,
                <&macro_tap>,
                <&kp KP_N7>,
                <&macro_tap>,
                <&kp KP_N1>,
                <&macro_release>,
                <&kp LEFT_ALT>;
        };

        guillemet_right: guillemet_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0>,
                <&macro_tap>,
                <&kp KP_N1>,
                <&macro_tap>,
                <&kp KP_N8>,
                <&macro_tap>,
                <&kp KP_N7>,
                <&macro_release>,
                <&kp LEFT_ALT>;
        };
    };

    behaviors {
        spacio_capa: spacio_capa {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACIO_CAPA";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        altBehaivor: altBehaivor {
            compatible = "zmk,behavior-hold-tap";
            label = "ALTBEHAIVOR";
            bindings = <&none>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <1280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <20 32 33 31>;
            hold-trigger-on-release;
        };

        altHoldFast: altHoldFast {
            compatible = "zmk,behavior-hold-tap";
            label = "ALTHOLDFAST";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-while-undecided;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        dvorack {
            bindings = <
                  &lt 5 COMMA     &kp RA(N)  &kp P    &kp Y           &kp F              &kp G        &kp C  &kp H          &kp L  &kp L
                  &mt LEFT_ALT A  &kp O      &kp E    &kp U           &kp I              &kp D        &kp R  &kp T          &kp N  &kp N
&kp LEFT_CONTROL  &kp Z           &kp Q      &kp J    &kp K           &kp X              &kp B        &kp M  &kp W          &kp V  &kp V  &kp S
                                             &kp TAB  &sk LEFT_SHIFT  &lt 4 BACKSPACE    &lt 3 SPACE  &mo 5  &sk RIGHT_ALT
            >;
        };

        base {
            bindings = <
                  &kp Q           &kp W        &kp E             &kp R           &kp T              &kp Y                 &kp U  &kp I          &kp O    &kp P
                  &mt LEFT_ALT A  &mt LCTRL S  &mt LEFT_SHIFT D  &kp F           &kp G              &kp H                 &kp J  &kp K          &kp L    &kp RA(N)
&kp LEFT_CONTROL  &kp Z           &kp X        &kp C             &kp V           &kp B              &kp N                 &kp M  &kp COMMA      &kp DOT  &kp LEFT_ALT  &kp LEFT_ALT
                                               &kp TAB           &sk LEFT_SHIFT  &lt 4 BACKSPACE    &spacio_capa 3 SPACE  &mo 5  &sk RIGHT_ALT
            >;
        };

        blender {
            bindings = <
               &kp Q                    &kp W                    &kp E             &kp R      &kp T              &kp Y                 &kp U  &kp I          &kp O    &kp P
               &altHoldFast LEFT_ALT A  &mt LCTRL S              &mt LEFT_SHIFT D  &kp F      &kp G              &kp H                 &kp J  &kp K          &kp L    &kp RA(N)
&kp BACKSPACE  &kp Z                    &altHoldFast LEFT_ALT X  &kp C             &kp V      &kp B              &kp N                 &kp M  &kp COMMA      &kp DOT  &kp LEFT_ALT  &kp LEFT_ALT
                                                                 &lt 5 TAB         &kp SPACE  &lt 4 BACKSPACE    &spacio_capa 3 SPACE  &mo 5  &sk RIGHT_ALT
            >;
        };

        programacion_simbolos {
            bindings = <
               &kp AMPS       &kp SQT           &kp DOUBLE_QUOTES  &kp LEFT_BRACE        &kp RIGHT_BRACE          &kp SLASH  &kp BACKSLASH  &kp RA(V)     &kp QUESTION  &kp TILDE
               &kp HASH       &kp SINGLE_QUOTE  &kp MINUS          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp COLON  &kp EQUAL      &kp PLUS      &kp MINUS     &kp DOLLAR
&kp LC(LS(B))  &kp LESS_THAN  &kp GREATER_THAN  &kp UNDERSCORE     &kp LEFT_BRACKET      &kp RIGHT_BRACKET        &kp SEMI   &kp ASTERISK   &kp SLASH     &kp RA(B)     &kp EXCLAMATION  &kp LC(LS(LA(B)))
                                                &kp AT_SIGN        &kp PERCENT           &kp RA(PERIOD)           &none      &none          &kp LEFT_WIN
            >;
        };

        navegacion {
            bindings = <
                  &kp ESCAPE     &kp BACKSPACE  &kp UP        &kp LC(LS(TAB))  &kp LC(TAB)    &kp LA(F16)  &kp LA(LS(T))  &kp LA(LS(F12))    &kp LA(F)     &kp NUMBER_5
                  &kp LC(LS(T))  &kp LEFT       &kp DOWN      &kp RIGHT        &kp LC(W)      &kp LA(F17)  &kp LCTRL      &kp RSHFT          &kp LEFT_ALT  &mo 6
&kp LEFT_CONTROL  &kp DEL        &kp LC(LS(N))  &kp ENTER     &kp LC(N)        &kp LC(T)      &kp LA(F15)  &kp LA(M)      &kp LC(RIGHT_ALT)  &kp LA(V)     &kp LA(RS(P))  &kp TAB
                                                &kp LEFT_WIN  &kp LEFT_ALT     &none          &mo 5        &kp TAB        &kp LS(LA(E))
            >;
        };

        unnicode_numeros {
            bindings = <
        &none   &kp N1  &kp N2  &kp N3     &kp TILDE        &kp EQUAL     &kp EXCLAMATION   &pregunta       &kp QUESTION  &kp EQUAL
        &kp N0  &kp N4  &kp N5  &kp N6     &kp N0           &kp COLON     &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp LEFT_ALT  &mo 6
&trans  &trans  &kp N7  &kp N8  &kp N9     &em_dash         &kp SEMI      &kp LEFT          &kp ENTER       &kp RIGHT     &kp SEMI   &kp TAB
                        &trans  &kp SPACE  &kp BACKSPACE    &kp LEFT_ALT  &trans            &trans
            >;
        };

        layer_5 {
            bindings = <
        &trans  &kp LG(E)      &kp LA(LS(W))      &kp LA(F4)     &trans    &trans  &kp LA(N1)  &kp LA(N2)  &kp LA(N3)  &trans
        &trans  &kp LA(LS(A))  &kp LS(LA(S))      &kp LS(LA(D))  &trans    &trans  &kp LA(N4)  &kp LA(N5)  &kp LA(N6)  &trans
&trans  &trans  &trans         &kp DOUBLE_QUOTES  &trans         &trans    &trans  &kp LA(N7)  &kp LA(N8)  &kp LA(N9)  &trans  &trans
                               &trans             &trans         &trans    &trans  &trans      &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
